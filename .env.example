# ==========================================
# Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach .env und trage deine echten Werte ein:
# cp .env.example .env
# ==========================================

# Standard-IP oder Hostname der Fritz!Box
FRITZBOX_HOST=192.168.178.1
FRITZBOX_UPNP_PORT=49000

# Optionaler Fritz!Box-Login (nur benötigt für Gäste-WLAN-Traffic & Prioritäts-Aufteilung via Online-Monitor)
FRITZBOX_USERNAME=
FRITZBOX_PASSWORD=

